DATABASE_URL=sqlite:///./acdss.db
FRONTEND_ORIGIN=http://localhost:5173

# LLM / AI keys (keep these secret — never commit real values!)
#
# Four credentials, two providers. Every LLM consumer (outer agent,
# Diagnosis_Agent, Treatment_Agent) tries both Groq keys first, then both
# Gemini keys, moving on automatically on any error — see .with_fallbacks()
# in app/llm_model.py and Dual_Agent's two llm_models.py. Groq's free tier
# is 6000 tokens/minute with no daily cap (a burst recovers within a
# minute); Gemini's is 20 requests/day PER (PROJECT, MODEL) — a hard wall
# that doesn't recover until the next day, and Diagnosis_Agent alone can
# burn 3-4 calls per report, so it's the fallback of last resort.
GROQ_API_KEY1=your_groq_api_key_here
GROQ_API_KEY2=your_second_groq_api_key_here
GOOGLE_API_KEY1=your_google_api_key_here
GOOGLE_API_KEY2=your_second_google_api_key_here

# Model per provider per consumer. Deliberately separate Gemini model names
# where a key is shared (outer agent + Diagnosis_Agent both fall back to
# KEY1) — quota is scoped per (project, model), so same key + different
# model still means two independent 20/day buckets instead of one shared
# one.
# ACDSS_CHAT_MODEL=llama-3.3-70b-versatile            (outer agent, Groq)
# ACDSS_CHAT_MODEL_GEMINI=gemini-3.5-flash            (outer agent, Gemini fallback)
# ACDSS_DIAGNOSIS_GROQ_MODEL=llama-3.1-8b-instant     (Diagnosis_Agent, Groq)
# ACDSS_DIAGNOSIS_CHAT_MODEL=gemini-3.1-flash-lite    (Diagnosis_Agent, Gemini fallback)
# ACDSS_TREATMENT_GROQ_MODEL=llama-3.1-8b-instant     (Treatment_Agent, Groq)
# ACDSS_TREATMENT_CHAT_MODEL=gemini-3.5-flash         (Treatment_Agent, Gemini fallback — own key already isolates it)

# Chroma DB paths (leave blank to use auto-detected relative paths)
# CHROMA_DIAGNOSIS_DB_PATH=
# CHROMA_TREATMENT_DB_PATH=

# Tesseract (Windows only — on Linux it uses system PATH)
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
